generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  reason    String
  timeframe String?
  guests    String?
  message   String
  createdAt DateTime @default(now())
}

model BookingSubmission {
  id             String   @id @default(cuid())
  name           String
  email          String
  phone          String?
  preferredDates String?
  guests         String?
  accommodation  String?
  message        String?
  createdAt      DateTime @default(now())
}

model NewsletterSubscription {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
